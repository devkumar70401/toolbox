#!/usr/bin/env bash
# ipynbtomd - Convert Jupyter Notebooks (.ipynb) to Markdown (.md)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -x "$HOME/SE/toolbox/.venv/bin/python" ]; then
    PYTHON_BIN="$HOME/SE/toolbox/.venv/bin/python"
elif [ -x "$HOME/SE/.venv/bin/python" ]; then
    PYTHON_BIN="$HOME/SE/.venv/bin/python"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN="python3"
else
    echo "Error: Python binary not found." >&2
    exit 1
fi

exec "$PYTHON_BIN" "$SCRIPT_DIR/ipynb_to_md.py" "$@"
