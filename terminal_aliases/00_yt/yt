#!/usr/bin/env bash
# yt - High-Speed YouTube MP3 Audio Downloader

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$SCRIPT_DIR/../bin"

if [ -d "$BIN_DIR" ]; then
    export PATH="$BIN_DIR:$PATH"
fi

if [ -x "$HOME/SE/toolbox/.venv/bin/python" ]; then
    PYTHON_BIN="$HOME/SE/toolbox/.venv/bin/python"
elif [ -x "$HOME/SE/.venv/bin/python" ]; then
    PYTHON_BIN="$HOME/SE/.venv/bin/python"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN="python3"
else
    echo "Error: Python binary not found." >&2
    exit 1
fi

CLI_SCRIPT="$SCRIPT_DIR/yt_downloader_cli.py"
if [ ! -f "$CLI_SCRIPT" ]; then
    CLI_SCRIPT="$HOME/SE/toolbox/terminal_aliases/00_yt/yt_downloader_cli.py"
fi

exec "$PYTHON_BIN" "$CLI_SCRIPT" --format mp3 "$@"
