#!/usr/bin/env bash
# aria - High-Speed Multi-Connection Downloader (IDM Style)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$SCRIPT_DIR/../bin"

if [ -d "$BIN_DIR" ]; then
    export PATH="$BIN_DIR:$PATH"
fi

DEFAULT_DOWNLOAD_DIR="$HOME/SE/toolbox/downloads"
mkdir -p "$DEFAULT_DOWNLOAD_DIR"

if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    echo -e "\033[1;36m==================================================\033[0m"
    echo -e "\033[1;32m  🚀 aria - Turbo Downloader (aria2c)\033[0m"
    echo -e "\033[1;36m==================================================\033[0m"
    echo -e "Usage:"
    echo -e "  aria <url> [options]"
    echo -e ""
    echo -e "Examples:"
    echo -e "  aria 'https://example.com/file.zip'"
    echo -e "  aria 'https://example.com/file.iso' -o custom.iso"
    echo -e "  aria 'https://example.com/file.zip' -d /path/to/folder"
    echo -e ""
    echo -e "Default save location: \033[1;34m$DEFAULT_DOWNLOAD_DIR\033[0m"
    exit 0
fi

# If user provided a magnet link or .torrent file, delegate to torrent mode
FIRST_ARG="$1"
if [[ "$FIRST_ARG" =~ ^magnet:\? ]] || [[ "$FIRST_ARG" =~ \.torrent$ ]]; then
    exec aria2c \
        --seed-time=0 \
        --enable-dht=true \
        --bt-enable-lpd=true \
        --summary-interval=1 \
        -d "$DEFAULT_DOWNLOAD_DIR" \
        "$@"
fi

exec aria2c \
    -x 16 \
    -s 16 \
    -k 1M \
    -c \
    --summary-interval=1 \
    -d "$DEFAULT_DOWNLOAD_DIR" \
    "$@"
