#!/usr/bin/env python3
"""
Pomodoro Native GNOME / Ubuntu AppIndicator Daemon
Provides a real-time status bar tomato icon, live countdown label, and control menu.
"""

import os
import sys
import subprocess
import signal

# Ensure clean environment free from Snap GTK path overrides
os.environ.pop("GTK_PATH", None)
os.environ.pop("LD_LIBRARY_PATH", None)

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('AyatanaAppIndicator3', '0.1')
from gi.repository import Gtk, AyatanaAppIndicator3, GLib

import shutil
from pathlib import Path

BIN_DIR = Path(__file__).parent.resolve()

def _resolve_bin(name: str) -> str:
    local_bin = BIN_DIR / name
    if local_bin.is_file() and os.access(local_bin, os.X_OK):
        return str(local_bin)
    sys_bin = shutil.which(name)
    if sys_bin:
        return sys_bin
    user_bin = Path.home() / ".local" / "bin" / name
    if user_bin.is_file() and os.access(user_bin, os.X_OK):
        return str(user_bin)
    return str(local_bin)

CLI_BIN = _resolve_bin("pomodoro-cli")
WRAPPER_BIN = _resolve_bin("pomodoro")
UI_BIN = _resolve_bin("pomodoro-ui")


class PomodoroNativeTray:
    def __init__(self):
        self.state = "idle"
        self.remaining_str = "--:--"
        self.input_locked = False

        # Create Native Ayatana AppIndicator
        self.indicator = AyatanaAppIndicator3.Indicator.new(
            "pomodoro-status-indicator",
            "alarm-symbolic",
            AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
        self.indicator.set_title("Pomodoro Timer")

        # Build initial menu
        self.menu = Gtk.Menu()
        self.build_menu()
        self.indicator.set_menu(self.menu)

        # Initial status query
        self.update_status()

        # Poll status every 1 second via GLib main loop (zero CPU)
        GLib.timeout_add_seconds(1, self.update_status)

    def query_daemon(self):
        try:
            res = subprocess.run([CLI_BIN, "status"], capture_output=True, text=True, timeout=1.0)
            if res.returncode != 0:
                return "idle", "--:--", False
            
            output = res.stdout
            state = "idle"
            remaining = "--:--"
            locked = "YES" in output

            for line in output.splitlines():
                if "Current State:" in line:
                    val = line.split("Current State:")[1].strip().upper()
                    if "WORKING" in val:
                        state = "work"
                    elif "BREAK" in val:
                        state = "break"
                    else:
                        state = "idle"
                elif "Remaining Time:" in line:
                    remaining = line.split("Remaining Time:")[1].strip()

            return state, remaining, locked
        except Exception:
            return "idle", "--:--", False

    def build_menu(self):
        # Clear existing menu items
        for child in self.menu.get_children():
            self.menu.remove(child)

        # 1. Header Title
        title_item = Gtk.MenuItem(label="🍅 Pomodoro Timer")
        title_item.set_sensitive(False)
        self.menu.append(title_item)

        # 2. Live Status String
        if self.state == "work":
            status_text = f"Status: 🍅 Working ({self.remaining_str} left)"
        elif self.state == "break":
            status_text = f"Status: ☕ Break ({self.remaining_str} left)"
        else:
            status_text = "Status: ⏸️ Idle / Ready"

        self.status_item = Gtk.MenuItem(label=status_text)
        self.status_item.set_sensitive(False)
        self.menu.append(self.status_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        # 3. Actions
        start_work_item = Gtk.MenuItem(label="🍅 Start Work (25m)")
        start_work_item.connect("activate", lambda w: self.run_cmd(["work"]))
        self.menu.append(start_work_item)

        start_break_item = Gtk.MenuItem(label="☕ Take Break (5m)")
        start_break_item.connect("activate", lambda w: self.run_cmd(["break"]))
        self.menu.append(start_break_item)

        stop_item = Gtk.MenuItem(label="⏹️ Stop / Pause Session")
        stop_item.connect("activate", lambda w: self.run_cmd(["stop"]))
        self.menu.append(stop_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        toggle_ui_item = Gtk.MenuItem(label="👁️ Toggle Floating Indicator")
        toggle_ui_item.connect("activate", lambda w: self.toggle_ui())
        self.menu.append(toggle_ui_item)

        self.menu.append(Gtk.SeparatorMenuItem())

        quit_item = Gtk.MenuItem(label="❌ Quit Tray")
        quit_item.connect("activate", lambda w: Gtk.main_quit())
        self.menu.append(quit_item)

        self.menu.show_all()

    def update_status(self):
        new_state, new_remaining, new_locked = self.query_daemon()
        state_changed = (new_state != self.state or new_locked != self.input_locked)
        
        self.state = new_state
        self.remaining_str = new_remaining
        self.input_locked = new_locked

        # Update Top Bar Icon and Label
        if self.state == "work":
            self.indicator.set_icon_full("alarm-symbolic", "Working")
            self.indicator.set_label(f" {self.remaining_str}", "30:00")
        elif self.state == "break":
            self.indicator.set_icon_full("weather-clear-symbolic", "Break")
            self.indicator.set_label(f" ☕ {self.remaining_str}", "10:00")
        else:
            self.indicator.set_icon_full("alarm-symbolic", "Idle")
            self.indicator.set_label(" ⏸️", "30:00")

        # Update menu label
        if hasattr(self, 'status_item'):
            if self.state == "work":
                self.status_item.set_label(f"Status: 🍅 Working ({self.remaining_str} left)")
            elif self.state == "break":
                self.status_item.set_label(f"Status: ☕ Break ({self.remaining_str} left)")
            else:
                self.status_item.set_label("Status: ⏸️ Idle / Ready")

        return True  # Keep GLib timer active

    def run_cmd(self, args):
        subprocess.run([WRAPPER_BIN] + args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.idle_add(self.update_status)

    def toggle_ui(self):
        res = subprocess.run(["pgrep", "-f", "pomodoro-ui"], capture_output=True)
        if res.returncode == 0:
            subprocess.run(["killall", "pomodoro-ui"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen([UI_BIN], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        GLib.idle_add(self.update_status)


def main():
    signal.signal(signal.SIGINT, lambda s, f: Gtk.main_quit())
    signal.signal(signal.SIGTERM, lambda s, f: Gtk.main_quit())
    app = PomodoroNativeTray()
    Gtk.main()


if __name__ == "__main__":
    main()
